# Copy to dashboard/.env.local to change. All optional.
VITE_API_MODE=mock                          # mock (sample runs + fixtures) | real (A's API)
VITE_API_BASE_URL=http://localhost:8000     # A's API, used in real mode
VITE_TESTBED_URL=http://localhost:8001      # C's testbed, for the chaos panel
VITE_SENTRY_ORG_URL=https://la-hacksss.sentry.io   # empty turns Sentry links off
