{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "navigate",
            "click",
            "fill",
            "select",
            "check",
            "uncheck",
            "press",
            "extract"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "into": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Into"
        }
      },
      "required": [
        "type"
      ],
      "title": "Action",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "description": "One entry in a program's history: how this version came to be.",
      "properties": {
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "source": {
          "enum": [
            "recorded",
            "compiled",
            "healed",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        }
      },
      "required": [
        "version",
        "source"
      ],
      "title": "Change",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One condition on the page. Exactly one kind is set.\n\nThe target_* kinds refer to the step's own target, so they can't be used without one\n(and never in the program's `success` list).",
      "properties": {
        "url_matches": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Matches"
        },
        "text_visible": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Visible"
        },
        "exists": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "absent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_unique": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Unique"
        },
        "target_enabled": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Enabled"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Value"
        }
      },
      "title": "Check",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "description": "What the element looked like when recorded. Tier-1 healing fuzzy-matches against it.",
      "properties": {
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "xpath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpath"
        },
        "near": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near"
        }
      },
      "required": [
        "tag"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "One way to find an element. Exactly one kind is set.\n\n`name` only goes with `role`; `exact` goes with role, label, placeholder or text.\n`xpath` must be absolute (/html/...); Browser Use records it without the leading slash.",
      "properties": {
        "testid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Testid"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "css": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Css"
        },
        "xpath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpath"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        }
      },
      "title": "Locator",
      "type": "object"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "Param",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^s\\d+[a-z]?$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pre": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Pre",
          "type": "array"
        },
        "post": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Post",
          "type": "array"
        },
        "timeout_ms": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "intent",
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "locators": {
          "items": {
            "$ref": "#/$defs/Locator"
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "locators"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "program": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Program",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "start_url": {
      "title": "Start Url",
      "type": "string"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/Param"
      },
      "title": "Params",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "success": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Success",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "program",
    "version",
    "task",
    "start_url",
    "steps"
  ],
  "title": "Program",
  "type": "object"
}
